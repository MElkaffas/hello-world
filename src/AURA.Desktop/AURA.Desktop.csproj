<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Aura.Desktop</RootNamespace>
    <AssemblyName>Aura.Desktop</AssemblyName>
    <StartupObject>Aura.Desktop.App</StartupObject>
  </PropertyGroup>

  <!-- UseWPF + UseWindowsForms together make the SDK implicitly global-`using` both
       System.Windows.Forms and System.Drawing project-wide, colliding with System.Windows /
       System.Windows.Input types of the same name (Application, Point, Size, MouseEventArgs,
       KeyEventArgs...) in every file, not just the one that actually needs WinForms (the tray
       icon). Removing the two implicit usings here and keeping them as ordinary file-scoped
       `using`s in TrayIconService.cs (the only file that needs them) fixes it at the root.
       Side effect confirmed via CI: for this WinExe+UseWPF+UseWindowsForms combination, System.IO
       is bundled into the same implicit-usings set as Drawing/WinForms, so removing these two
       also removes System.IO's implicit availability project-wide - every file using
       Path/File/Directory needs its own explicit `using System.IO;` now (plain library projects
       like AURA.Core are unaffected; they keep getting System.IO implicitly as normal). -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AURA.Core\AURA.Core.csproj" />
    <ProjectReference Include="..\AURA.Host\AURA.Host.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\samples\rules\**\*.json" LinkBase="Rules" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\samples\profiles\**\*.json" LinkBase="Profiles" CopyToOutputDirectory="PreserveNewest" />
    <!-- Ships as tenant.json at the output root so App.xaml.cs's LoadConfiguration finds it -
         edit or replace this file per tenant/deployment without touching any code. -->
    <None Include="..\..\samples\host\tenant.default.json" Link="tenant.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
