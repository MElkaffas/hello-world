<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Aura.Desktop</RootNamespace>
    <AssemblyName>Aura.Desktop</AssemblyName>
    <StartupObject>Aura.Desktop.App</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AURA.Core\AURA.Core.csproj" />
    <ProjectReference Include="..\AURA.Host\AURA.Host.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\samples\rules\**\*.json" LinkBase="Rules" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\samples\profiles\**\*.json" LinkBase="Profiles" CopyToOutputDirectory="PreserveNewest" />
    <!-- Ships as tenant.json at the output root so App.xaml.cs's LoadConfiguration finds it -
         edit or replace this file per tenant/deployment without touching any code. -->
    <None Include="..\..\samples\host\tenant.default.json" Link="tenant.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
