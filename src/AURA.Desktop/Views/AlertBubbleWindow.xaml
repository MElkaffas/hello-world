<Window x:Class="Aura.Desktop.Views.AlertBubbleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AURA"
        Width="300" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">
    <Border Style="{StaticResource BlueprintCardBorder}" BorderBrush="{StaticResource Accent700Brush}" Padding="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" Opacity="0.22" ShadowDepth="6" Color="#2B2B2D" />
        </Border.Effect>
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="CounterText" Grid.Column="0" Style="{StaticResource MutedText}" Text="1 of 1" />
                <TextBlock Grid.Column="1" Style="{StaticResource CornerMark}" />
            </Grid>

            <TextBlock x:Name="MessageText" Style="{StaticResource HeadingText}" FontSize="16"
                       TextWrapping="Wrap" Margin="0,6,0,0" />

            <Border Background="{StaticResource Neutral200Brush}" Margin="0,10,0,0" Padding="10,8">
                <TextBlock x:Name="PreviewText" Style="{StaticResource BodyTextStyle}" FontSize="12" TextWrapping="Wrap" />
            </Border>

            <TextBlock x:Name="StatusText" Style="{StaticResource MutedText}" Margin="0,8,0,0" Visibility="Collapsed" />

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="NextButton" Grid.Column="0" Content="Next" HorizontalAlignment="Left"
                        Style="{StaticResource SecondaryButton}" Click="OnNextClicked" Visibility="Collapsed" />

                <Button x:Name="IgnoreButton" Grid.Column="1" Content="Ignore" Margin="0,0,8,0"
                        Style="{StaticResource SecondaryButton}" Click="OnIgnoreClicked" />

                <Button x:Name="ApplyButton" Grid.Column="2" Content="Apply" Style="{StaticResource PrimaryButton}"
                        Click="OnApplyClicked" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
