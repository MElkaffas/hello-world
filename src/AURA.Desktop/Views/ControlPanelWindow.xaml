<Window x:Class="Aura.Desktop.Views.ControlPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AURA Control Panel"
        Width="300" Height="620"
        Background="{StaticResource BgBrush}"
        ResizeMode="CanMinimize"
        WindowStartupLocation="Manual">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">

            <!-- Brand + language -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="AURA" Style="{StaticResource HeadingText}" FontSize="24" />
                    <TextBlock Text="AI Unified Remote Assistant" Style="{StaticResource MutedText}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="LanguageEnButton" Content="EN" Style="{StaticResource SecondaryButton}"
                            Padding="8,4" Margin="0,0,4,0" Click="OnLanguageEnClicked" />
                    <Button x:Name="LanguageArButton" Content="AR" Style="{StaticResource SecondaryButton}"
                            Padding="8,4" Click="OnLanguageArClicked" />
                </StackPanel>
            </Grid>

            <!-- Control panel -->
            <Border Style="{StaticResource BlueprintCardBorder}" Margin="0,16,0,0" Padding="12">
                <StackPanel>
                    <TextBlock Text="CONTROL" Style="{StaticResource HeadingText}" FontSize="13" />

                    <TextBlock Text="Simulate" Style="{StaticResource MutedText}" Margin="0,10,0,4" />
                    <RadioButton x:Name="OutlookRadio" Content="Outlook compose issue" GroupName="Simulate" IsChecked="True" />
                    <RadioButton x:Name="WordRadio" Content="Word document issue" GroupName="Simulate" Margin="0,4,0,0" />

                    <TextBlock Text="Assistant style" Style="{StaticResource MutedText}" Margin="0,10,0,4" />
                    <ComboBox x:Name="StyleCombo" SelectionChanged="OnStyleChanged" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="SelectAreaButton" Grid.Column="0" Content="Select Area"
                                Style="{StaticResource SecondaryButton}" Margin="0,0,4,0" Click="OnSelectAreaClicked" />
                        <Button x:Name="StartStopButton" Grid.Column="1" Content="Start" Margin="4,0,0,0"
                                Style="{StaticResource PrimaryButton}" Click="OnStartStopClicked" />
                    </Grid>

                    <TextBlock x:Name="StatusText" Style="{StaticResource MutedText}" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Monitoring scope -->
            <Border Style="{StaticResource BlueprintCardBorder}" Margin="0,12,0,0" Padding="12">
                <StackPanel>
                    <TextBlock Text="MONITORING SCOPE" Style="{StaticResource HeadingText}" FontSize="13" />
                    <ComboBox x:Name="ScopeCombo" Margin="0,8,0,0" SelectionChanged="OnScopeChanged" />
                    <TextBlock Text="AURA only reads what this scope allows. Nothing outside it is captured."
                               Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- Knowledge base -->
            <Border Style="{StaticResource BlueprintCardBorder}" Margin="0,12,0,0" Padding="12">
                <StackPanel>
                    <TextBlock Text="KNOWLEDGE BASE" Style="{StaticResource HeadingText}" FontSize="13" />
                    <WrapPanel Margin="0,8,0,0">
                        <Border Background="{StaticResource Accent100Brush}" Margin="0,0,6,6" Padding="8,3">
                            <TextBlock Text="Regulatory" Style="{StaticResource BodyTextStyle}" FontSize="11" />
                        </Border>
                        <Border Background="{StaticResource Accent100Brush}" Margin="0,0,6,6" Padding="8,3">
                            <TextBlock Text="Telecom" Style="{StaticResource BodyTextStyle}" FontSize="11" />
                        </Border>
                        <Border Background="{StaticResource Accent100Brush}" Margin="0,0,6,6" Padding="8,3">
                            <TextBlock Text="Banking" Style="{StaticResource BodyTextStyle}" FontSize="11" />
                        </Border>
                        <Border Background="{StaticResource Accent100Brush}" Margin="0,0,6,6" Padding="8,3">
                            <TextBlock Text="Legal" Style="{StaticResource BodyTextStyle}" FontSize="11" />
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Privacy indicator -->
            <Border Background="{StaticResource Accent900Brush}" Margin="0,12,0,0" Padding="12">
                <StackPanel>
                    <TextBlock Text="PRIVACY INDICATOR" Style="{StaticResource HeadingText}" FontSize="12" Foreground="White" />
                    <TextBlock x:Name="PrivacyStatusText" Foreground="White" Style="{StaticResource BodyTextStyle}"
                               FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <Button x:Name="DeleteDataButton" Content="Delete captured data" Margin="0,10,0,0"
                            Style="{StaticResource SecondaryButton}" Foreground="White" BorderBrush="White"
                            Click="OnDeleteDataClicked" />
                </StackPanel>
            </Border>

            <!-- Audit log -->
            <Border Style="{StaticResource BlueprintCardBorder}" Margin="0,12,0,0" Padding="12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="AUDIT LOG" Style="{StaticResource HeadingText}" FontSize="13" />
                        <Button Grid.Column="1" Content="Refresh" Style="{StaticResource SecondaryButton}"
                                Padding="8,2" Click="OnRefreshAuditClicked" />
                    </Grid>
                    <ListBox x:Name="AuditListBox" Margin="0,8,0,0" Height="140" BorderThickness="1"
                             BorderBrush="{StaticResource Neutral300Brush}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Window>
