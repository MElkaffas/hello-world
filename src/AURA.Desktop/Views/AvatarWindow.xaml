<Window x:Class="Aura.Desktop.Views.AvatarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AURA"
        Width="110" Height="130"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <Storyboard x:Key="BobStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="BobTransform" Storyboard.TargetProperty="Y"
                             From="0" To="-4" Duration="0:0:1.7" />
        </Storyboard>

        <Storyboard x:Key="WalkStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="BobTransform" Storyboard.TargetProperty="Y"
                             From="0" To="-6" Duration="0:0:0.55" />
            <DoubleAnimation Storyboard.TargetName="TiltTransform" Storyboard.TargetProperty="Angle"
                             From="-2" To="2" Duration="0:0:0.55" />
        </Storyboard>

        <Storyboard x:Key="BlinkStoryboard" RepeatBehavior="Forever">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LeftEyeScale" Storyboard.TargetProperty="ScaleY">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                <LinearDoubleKeyFrame KeyTime="0:0:5.1" Value="1" />
                <LinearDoubleKeyFrame KeyTime="0:0:5.35" Value="0.12" />
                <LinearDoubleKeyFrame KeyTime="0:0:5.5" Value="1" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RightEyeScale" Storyboard.TargetProperty="ScaleY">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                <LinearDoubleKeyFrame KeyTime="0:0:5.1" Value="1" />
                <LinearDoubleKeyFrame KeyTime="0:0:5.35" Value="0.12" />
                <LinearDoubleKeyFrame KeyTime="0:0:5.5" Value="1" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <Storyboard x:Key="PulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="AntennaDot" Storyboard.TargetProperty="Opacity"
                             From="1.0" To="0.35" Duration="0:0:0.6" />
        </Storyboard>
    </Window.Resources>

    <Grid Background="Transparent" MouseLeftButtonDown="OnRobotMouseDown">
        <StackPanel x:Name="RobotBody" HorizontalAlignment="Center" VerticalAlignment="Top"
                    RenderTransformOrigin="0.5,0.5">
            <StackPanel.RenderTransform>
                <TransformGroup>
                    <TranslateTransform x:Name="BobTransform" X="0" Y="0" />
                    <RotateTransform x:Name="TiltTransform" Angle="0" />
                </TransformGroup>
            </StackPanel.RenderTransform>

            <Ellipse x:Name="AntennaDot" Width="8" Height="8" Fill="{StaticResource Accent900Brush}"
                     HorizontalAlignment="Center" Margin="0,4,0,0" />
            <Rectangle Width="2" Height="15" Fill="{StaticResource Accent700Brush}" HorizontalAlignment="Center" />

            <Border Width="92" Height="64" CornerRadius="13" BorderThickness="2"
                    BorderBrush="{StaticResource Accent700Brush}" Background="{StaticResource Neutral100Brush}"
                    Margin="0,3,0,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" Opacity="0.16" ShadowDepth="3" Color="#2B2B2D" />
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                        <Grid x:Name="LeftEye" Width="23" Height="25" Margin="0,0,12,0">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="LeftEyeScale" ScaleX="1" ScaleY="1" CenterX="11.5" CenterY="12.5" />
                            </Grid.RenderTransform>
                            <Ellipse Fill="{StaticResource Accent900Brush}" />
                            <Ellipse x:Name="LeftPupil" Width="10" Height="10" Fill="#EEF6FF"
                                     HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,7,0,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="LeftPupilOffset" X="0" Y="0" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <Grid x:Name="RightEye" Width="23" Height="25">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="RightEyeScale" ScaleX="1" ScaleY="1" CenterX="11.5" CenterY="12.5" />
                            </Grid.RenderTransform>
                            <Ellipse Fill="{StaticResource Accent900Brush}" />
                            <Ellipse x:Name="RightPupil" Width="10" Height="10" Fill="#EEF6FF"
                                     HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,7,0,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="RightPupilOffset" X="0" Y="0" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                    </StackPanel>

                    <Grid HorizontalAlignment="Center" Margin="0,5,0,0" Height="12">
                        <Rectangle x:Name="MouthNeutral" Width="16" Height="2" RadiusX="1" RadiusY="1"
                                   Fill="{StaticResource Accent700Brush}" Visibility="Visible" />
                        <Ellipse x:Name="MouthAlert" Width="11" Height="11"
                                 Stroke="{StaticResource Accent700Brush}" StrokeThickness="2" Visibility="Collapsed" />
                        <Path x:Name="MouthHappy" Width="20" Height="10" Stretch="Uniform"
                              Stroke="{StaticResource Accent700Brush}" StrokeThickness="2" Visibility="Collapsed"
                              Data="M 0,0 A 10,10 0 0 0 20,0" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border x:Name="BodyChip" Width="66" Height="32" CornerRadius="8" BorderThickness="2"
                    BorderBrush="{StaticResource Accent700Brush}" Background="{StaticResource Neutral100Brush}"
                    Margin="0,5,0,0" HorizontalAlignment="Center">
                <Rectangle Width="32" Height="13" RadiusX="3" RadiusY="3" Fill="{StaticResource Accent200Brush}" />
            </Border>
        </StackPanel>
    </Grid>
</Window>
